    "Version": "1.0.auto",
    "Name": "Discord",
    "Icon": "icon2/icon.png",
    "CategoryIcon": "icon2/icon.png",
    "Category": "Discord",
    "Description": "discord operation",
    "CodePath": "plugin/index.js",
    "SDKVersion": 1,
    "ApplicationsToMonitor": {
        "mac": ["Discord"],
        "windows": ["Discord.exe", "DiscordPTB.exe"]
    },
    "Author": "MiraBox",
    "URL": "https://mirabox.key123.vip/home",
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "10.11"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "7"
        }
    ],
    "Software": {
        "MinimumVersion": "3.10.188.226"
    },
    "Nodejs": {
        "Version": "20"
    }
}
