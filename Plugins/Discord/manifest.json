{
    "$schema": "https://schemas.key123.vip/streamdock/plugins/manifest.json",
    "Actions": [
        {
            "Icon": "icon2/mute.png",
            "Name": "麦克风静音",
            "States": [
                {
                    "Image": "icon/unmute.png"
                },
                {
                    "Image": "icon/mute.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.mute",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/deafen.png",
            "Name": "耳机静音",
            "States": [
                {
                    "Image": "icon/undeafen.png"
                },
                {
                    "Image": "icon/deafen.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.deaf",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/voiceChannel.png",
            "Name": "语音通道",
            "States": [
                {
                    "Image": "icon/voicechannel.png"
                },
                {
                    "Image": "icon/leaveVoiceChannel.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.voicechannel",
            "PropertyInspectorPath": "index.html",
            "Settings": {
                "iconDisplayMode": "static"
            }
        },
        {
            "Icon": "icon2/textChannel.png",
            "Name": "文本通道",
            "States": [
                {
                    "Image": "icon/textchannel.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.textchannel",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/notifications.png",
            "Name": "通知",
            "States": [
                {
                    "Image": "icon/notice.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.notice",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/userVolumeControl.png",
            "Name": "用户音量控制",
            "States": [
                {
                    "TitleAlignment": "bottom",
                    "Image": "icon/unuserVolumeControl.png"
                },
                {
                    "TitleAlignment": "bottom",
                    "Image": "icon/userVolumeControl.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.userVolumeControl",
            "PropertyInspectorPath": "index.html",
            "Settings": {
                "mode": "mute",
                "adjustment": 25,
                "volume": 100
            }
        },
        {
            "Icon": "icon2/userVolumeControl.png",
            "Name": "用户音量控制",
            "States": [
                {
                    "TitleAlignment": "bottom",
                    "Image": "icon/unuserVolumeControl.png"
                },
                {
                    "TitleAlignment": "bottom",
                    "Image": "icon/userVolumeControl.png"
                }
            ],
            "Controllers": ["Knob"],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.userVolumeControlKnob",
            "PropertyInspectorPath": "index.html",
            "Settings": {
                "mode": "adjustment",
                "adjustment": 1
            }
        },
        {
            "Icon": "icon2/volumeControl.png",
            "Name": "音量控制",
            "States": [
                {
                    "Image": "icon/volumeControl.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.volumeControl",
            "PropertyInspectorPath": "index.html",
            "Settings": {
                "rdio": "output",
                "slider": 50
            }
        },
        {
            "Icon": "icon2/volumeControl.png",
            "Name": "音量控制",
            "States": [
                {
                    "TitleAlignment": "bottom",
                    "Image": "icon/volumeControl.png"
                }
            ],
            "Controllers": ["Knob"],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.volumeControlKnob",
            "PropertyInspectorPath": "index.html",
            "Settings": {
                "rdio": "output",
                "adjustment": 1
            }
        },
        {
            "Icon": "icon2/soundboard.png",
            "Name": "语音板",
            "States": [
                {
                    "FontSize": "9",
                    "TitleAlignment": "bottom",
                    "Image": "icon/unvoiceboard.png"
                },
                {
                    "FontSize": "9",
                    "TitleAlignment": "bottom",
                    "Image": "icon/voiceboard.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.voiceboard",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/setAudioDevice.png",
            "Name": "设置音频设备",

            "States": [
                {
                    "TitleAlignment": "center",
                    "Image": "icon/setDevices.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.setDevices",
            "PropertyInspectorPath": "index.html",
            "Settings": {
                "mode": "input"
            }
        },
        {
            "Icon": "icon2/toggleCamera.png",
            "Name": "打开/关闭摄像头",
            "States": [
                {
                    "Image": "icon/unvideo.png"
                },
                {
                    "Image": "icon/video.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.toggleVideo",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/toggleScreenShare.png",
            "Name": "打开/关闭屏幕共享",
            "States": [
                {
                    "Image": "icon/unscreenShare.png"
                },
                {
                    "Image": "icon/screenShare.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.screenShare",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/pushToTalk.png",
            "Name": "按住讲话",
            "States": [
                {
                    "Image": "icon/unpushtotalk.png"
                },
                {
                    "Image": "icon/pushtotalk.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": false,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.pushtotalk",
            "PropertyInspectorPath": "index.html"
        },
        {
            "Icon": "icon2/voiceInputModeToggle.png",
            "Name": "切换语音输入模式",
            "States": [
                {
                    "Image": "icon/pushtotalk.png"
                },
                {
                    "Image": "icon/voiceActivation.png"
                }
            ],
            "UserTitleEnabled": true,
            "SupportedInMultiActions": true,
            "Tooltip": "discord operation",
            "UUID": "com.hotspot.streamdock.discord.voiceActivationToggle",
            "PropertyInspectorPath": "index.html"
        }
