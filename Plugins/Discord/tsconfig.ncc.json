{
    "include": ["src/node/**/*"],
    "compilerOptions": {
        "target": "es2020",
        "lib": ["es2020"],
        "sourceMap": true,
        "inlineSources": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strict": false,
        "allowJs": true,
        "checkJs": false,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "types": ["@mirabox/streamdock-sdk/types"],
        "rootDir": "./src/node",
        "outDir": "./build/tsc_build"
    }
}
