{
    "name": "windows-shortcuts-streamdeck",
    "version": "1.0.0",
    "private": true,
    "description": "Stream Deck / StreamDock plugin with Windows shortcuts, starting with a Windows 11 Do Not Disturb toggle.",
    "author": "Matheus Cristoni",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MCristoni/windows-shortcuts-streamdeck.git"
    },
    "homepage": "https://github.com/MCristoni/windows-shortcuts-streamdeck#readme",
    "bugs": {
        "url": "https://github.com/MCristoni/windows-shortcuts-streamdeck/issues"
    },
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"npm run reload\"",
        "reload": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/reload-plugin.ps1",
        "icons": "node tools/build-icons.mjs",
        "pack": "node tools/pack.mjs"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.9.0",
        "@resvg/resvg-js": "^2.6.2",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.0.0"
    }
}
